generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  create_at DateTime? @default(now())
  update_at DateTime? @default(now())
  categories Category[]
  suppliers  Supplier[]
  products   Product[]
  @@map("users")
}
model Category {
  id   Int    @id @default(autoincrement())
  name String
  create_at DateTime? @default(now())
  update_at DateTime? @default(now())
  user   User @relation(fields: [userId], references: [id])
  userId Int
  products Product[]
  @@map("categories")
}
model Supplier {
  id    Int    @id @default(autoincrement())
  name  String
  email String
  phone String
  create_at DateTime? @default(now())
  update_at DateTime? @default(now())
  user   User @relation(fields: [userId], references: [id])
  userId Int
  products Product[]
  @@map("suppliers")
}
model Product {
  id          Int     @id @default(autoincrement())
  name        String
  price       Decimal @db.Decimal(10, 2)
  description String
  banner      String
  amount      Int
  create_at DateTime? @default(now())
  update_at DateTime? @default(now())
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  supplierId Int
  user   User @relation(fields: [userId], references: [id])
  userId Int
  items Item[]
  @@map("products")
}
model Item {
  id     Int    @id @default(autoincrement())
  amount String
  create_at DateTime? @default(now())
  update_at DateTime? @default(now())
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  @@map("items")
}